rules_version = '2';

// ============================================================================
// BELT-KIT — Firestore Security Rules (free-tier, lean get() usage)
// ----------------------------------------------------------------------------
// role/branch come from /users/{uid}. To avoid exceeding Firestore's per-request
// get() limit, we read the user doc AT MOST ONCE per request via a single
// helper. Single-branch system, so no rule needs the doc's branchId.
//
// Permission model (per team decision): OWNER, FRONT DESK (advisor) and
// TECHNICIAN all have FULL access to the operational data (customers, vehicles,
// jobs, job lines, parts, services, suppliers, employees, etc.). Manager and
// accountant keep access too. Only genuinely dangerous actions (deleting staff,
// editing branches) stay owner/manager-only.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Single source: the caller's /users doc data (one get per request path).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Role ALWAYS from the /users doc so seeded (claim) and created (no claim)
    // users take the IDENTICAL code path. Requires the /users doc to exist.
    function myRole() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? me().role : null;
    }

    // Any signed-in staff member.
    function isStaff() {
      return myRole() in ['owner', 'manager', 'advisor', 'technician', 'accountant'];
    }
    // The full-access team: owner, front desk, technician (+ manager kept).
    function isTeam() {
      return myRole() in ['owner', 'manager', 'advisor', 'technician'];
    }
    // Finance actions: invoices + payments (team + accountant).
    function isFinance() {
      return myRole() in ['owner', 'manager', 'advisor', 'technician', 'accountant'];
    }
    // True when an update touches ONLY the whitelisted fields (nothing else
    // changed). Used to keep generated invoice amounts immutable while still
    // letting a payment update the balance + status.
    function onlyChanged(allowedKeys) {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(allowedKeys);
    }
    function validInvoiceState(data) {
      return data.subtotalMinor is int && data.subtotalMinor >= 0
             && data.taxMinor is int && data.taxMinor >= 0
             && data.totalMinor is int && data.totalMinor > 0
             && data.amountPaidMinor is int && data.amountPaidMinor >= 0
             && data.amountPaidMinor <= data.totalMinor
             && (!data.keys().hasAny(['taxRatePercent'])
                 || (data.taxRatePercent is number
                     && data.taxRatePercent >= 0
                     && data.taxRatePercent <= 100))
             && data.status in ['draft', 'issued', 'part_paid', 'paid', 'void']
             && (data.status != 'paid'
                 || data.amountPaidMinor == data.totalMinor)
             && (data.status != 'part_paid'
                 || (data.amountPaidMinor > 0
                     && data.amountPaidMinor < data.totalMinor));
    }
    function validPaymentCreate() {
      let data = request.resource.data;
      let invoicePath = /databases/$(database)/documents/invoices/$(data.invoiceId);
      let before = get(invoicePath).data;
      let after = getAfter(invoicePath).data;
      return data.keys().hasAll([
               'branchId', 'invoiceId', 'customerId', 'amountMinor', 'method',
               'archived', 'createdByUid', 'createdAt', 'updatedAt'
             ])
             && data.keys().hasOnly([
               'branchId', 'invoiceId', 'customerId', 'customerUid',
               'amountMinor', 'method', 'reference', 'cardLast4', 'provider',
               'archived', 'createdByUid', 'createdAt', 'updatedAt'
             ])
             && data.branchId is string
             && data.invoiceId is string
             && data.customerId is string
             && data.amountMinor is int && data.amountMinor > 0
             && data.method in ['cash', 'card', 'bank_transfer', 'wallet']
             && data.archived == false
             && data.createdByUid == request.auth.uid
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && (!data.keys().hasAny(['reference']) || data.reference is string)
             && (!data.keys().hasAny(['cardLast4'])
                 || (data.cardLast4 is string && data.cardLast4.size() == 4))
             && (!data.keys().hasAny(['provider']) || data.provider is string)
             && exists(invoicePath)
             && before.branchId == data.branchId
             && before.customerId == data.customerId
             && before.status != 'void'
             && data.amountMinor <= before.totalMinor - before.amountPaidMinor
             && after.diff(before).affectedKeys().hasOnly([
               'amountPaidMinor', 'status', 'updatedByUid', 'updatedAt'
             ])
             && after.amountPaidMinor == before.amountPaidMinor + data.amountMinor
             && after.status == (after.amountPaidMinor == after.totalMinor
                 ? 'paid' : 'part_paid')
             && validInvoiceState(after);
    }

    // ---- Users -----------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();                 // any signed-in user may read
      allow create, update: if myRole() in ['owner', 'manager', 'advisor']
                    || (request.auth.uid == userId
                        && request.resource.data.role in ['owner', 'pending']);
      allow delete: if myRole() in ['owner', 'manager']; // deleting staff stays restricted
    }

    match /meta/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && docId == 'bootstrap'
                    && !exists(/databases/$(database)/documents/meta/bootstrap);
      allow update, delete: if false;
    }

    // ---- Branches (structural — keep restricted) -------------------------
    match /branches/{branchId} {
      allow read: if signedIn();
      allow write: if myRole() in ['owner', 'manager'];
    }

    // ---- Operational data: full access for the team ----------------------
    // Customers
    match /customers/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Vehicles
    match /vehicles/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Job Cards — technicians can now fully update (photos, status, etc.)
    match /jobCards/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Job card lines (labour & parts)
    match /jobCardLines/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Inventory
    match /parts/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    match /stockMovements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if false;   // history never edited
      allow delete: if isTeam();
    }
    // Services (service types offered by the garage)
    match /services/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }

    // ---- Upcoming new collections (pre-added so no future block) ----------
    // Suppliers
    match /suppliers/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Purchase orders (to suppliers)
    match /purchaseOrders/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Supplier payments
    match /supplierPayments/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Employees
    match /employees/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Employee pay records
    match /employeePayments/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Attendance / leave
    match /attendance/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // In-app notifications
    match /notifications/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }
    // Job photos (before/after) — if stored as their own collection
    match /jobPhotos/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isTeam();
    }
    // Insurance claims
    match /insuranceClaims/{id} {
      function isInsuranceManager() {
        return myRole() in ['owner', 'manager', 'advisor'];
      }

      function isInsuranceAccountant() {
        return myRole() == 'accountant';
      }

      function validIsoDate(value) {
        return value is timestamp
               || value == null
               || (value is string
                   && (value == ''
                       || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }

      function validClaimShape(data) {
        return data.keys().hasAll([
                 'schemaVersion', 'branchId', 'jobCardId', 'customerId',
                 'vehicleId', 'invoiceId', 'finalInvoiceId', 'companyName',
                 'policyNumber', 'claimNumber', 'currency', 'accidentDate',
                 'paymentRoute',
                 'caseStage', 'approvalStatus', 'releaseStatus',
                 'settlementStatus', 'documentStatus', 'documentCount',
                 'verifiedDocumentCount', 'assessorName', 'assessmentDate',
                 'assessmentReference', 'finalInvoiceAmountMinor',
                 'finalInvoiceTotalMinor', 'claimAmountMinor',
                 'assessedAmountMinor', 'approvedAmountMinor',
                 'insurerResponsibilityMinor', 'customerResponsibilityMinor',
                 'insurerReceivedMinor', 'customerReceivedMinor',
                 'receivedAmountMinor', 'writeOffMinor', 'releaseOrderNumber',
                 'releaseOrderDate', 'expectedSettlementDate', 'releasedAt',
                 'releasedByUid', 'status', 'notes', 'archived',
                 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
               ])
               && data.keys().hasOnly([
                 'schemaVersion', 'branchId', 'jobCardId', 'customerId',
                 'vehicleId', 'invoiceId', 'finalInvoiceId', 'companyName',
                 'policyNumber', 'claimNumber', 'currency', 'paymentRoute',
                 'caseStage', 'approvalStatus', 'releaseStatus',
                 'settlementStatus', 'documentStatus', 'documentCount',
                 'verifiedDocumentCount', 'assessorName', 'assessmentReference',
                 'accidentDate', 'assessmentDate', 'quantumEstablishedAt',
                 'dischargeDocumentsReceivedAt', 'identityVerifiedAt',
                 'expectedSettlementDate', 'regulatorySettlementDate',
                 'finalInvoiceAmountMinor', 'finalInvoiceTotalMinor',
                 'claimAmountMinor', 'assessedAmountMinor',
                 'approvedAmountMinor', 'insurerResponsibilityMinor',
                 'insurerReceivedMinor', 'customerResponsibilityMinor',
                 'customerReceivedMinor', 'receivedAmountMinor',
                 'writeOffMinor', 'releaseOrderNumber', 'releaseOrderDate',
                 'releasedAt', 'releasedByUid', 'status', 'notes', 'archived',
                 'insurerPaymentMethod', 'insurerPaymentReference',
                 'customerPaymentReference', 'chequeStatus',
                 'chequeReceivedAt', 'chequeClearedAt', 'settlementNotes',
                 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt'
               ]);
      }

      function validClaimTypes(data) {
        return data.schemaVersion == 2
               && data.branchId is string && data.branchId.size() > 0
               && data.jobCardId is string && data.jobCardId.size() > 0
               && data.customerId is string && data.customerId.size() > 0
               && data.vehicleId is string && data.vehicleId.size() > 0
               && (data.invoiceId == null || data.invoiceId is string)
               && (data.finalInvoiceId == null || data.finalInvoiceId is string)
               && data.invoiceId == data.finalInvoiceId
               && data.companyName is string && data.companyName.size() > 0
               && data.policyNumber is string && data.claimNumber is string
               && data.currency is string && data.assessorName is string
               && data.assessmentReference is string
               && data.releaseOrderNumber is string && data.notes is string
               && data.archived is bool
               && data.createdByUid is string && data.createdByUid.size() > 0
               && data.updatedByUid is string && data.updatedByUid.size() > 0
               && data.createdAt is timestamp && data.updatedAt is timestamp
               && (data.releasedByUid == null || data.releasedByUid is string)
               && (!data.keys().hasAny(['insurerPaymentReference'])
                   || data.insurerPaymentReference is string)
               && (!data.keys().hasAny(['customerPaymentReference'])
                   || data.customerPaymentReference is string)
               && (!data.keys().hasAny(['settlementNotes'])
                   || data.settlementNotes is string);
      }

      function validClaimDates(data) {
        return validIsoDate(data.accidentDate)
               && validIsoDate(data.assessmentDate)
               && validIsoDate(data.releaseOrderDate)
               && validIsoDate(data.expectedSettlementDate)
               && validIsoDate(data.releasedAt)
               && (!data.keys().hasAny(['regulatorySettlementDate'])
                   || validIsoDate(data.regulatorySettlementDate))
               && (!data.keys().hasAny(['quantumEstablishedAt'])
                   || validIsoDate(data.quantumEstablishedAt))
               && (!data.keys().hasAny(['dischargeDocumentsReceivedAt'])
                   || validIsoDate(data.dischargeDocumentsReceivedAt))
               && (!data.keys().hasAny(['identityVerifiedAt'])
                   || data.identityVerifiedAt == null
                   || data.identityVerifiedAt is timestamp)
               && (!data.keys().hasAny(['chequeReceivedAt'])
                   || validIsoDate(data.chequeReceivedAt))
               && (!data.keys().hasAny(['chequeClearedAt'])
                   || validIsoDate(data.chequeClearedAt));
      }

      function validClaimEnums(data) {
        return data.paymentRoute in ['insurer_direct', 'customer_direct', 'split']
               && data.caseStage in [
                 'intake', 'documents', 'assessment', 'approval', 'repair',
                 'final_invoice', 'release', 'settlement', 'closed'
               ]
               && data.approvalStatus in [
                 'pending', 'partly_approved', 'partially_approved', 'approved',
                 'rejected', 'disputed'
               ]
               && data.releaseStatus in [
                 'blocked', 'eligible', 'release_order_verified', 'authorized',
                 'released'
               ]
               && data.settlementStatus in [
                 'not_due', 'insurer_pending', 'customer_pending', 'part_paid',
                 'overdue', 'disputed', 'reconciled'
               ]
               && data.status in ['pending', 'approved', 'received', 'rejected']
               && data.documentStatus in [
                 'not_started', 'incomplete', 'ready_for_review', 'verified'
               ]
               && (!data.keys().hasAny(['insurerPaymentMethod'])
                   || data.insurerPaymentMethod in [
                     'cash', 'cheque', 'bank_transfer', 'card', 'other'
                   ])
               && (!data.keys().hasAny(['chequeStatus'])
                   || data.chequeStatus in [
                     'not_applicable', 'expected', 'received', 'deposited',
                     'cleared', 'bounced', 'reversed'
                   ]);
      }

      function validClaimMoney(data) {
        return data.finalInvoiceAmountMinor is int
               && data.finalInvoiceAmountMinor >= 0
               && data.finalInvoiceTotalMinor is int
               && data.finalInvoiceTotalMinor >= 0
               && data.finalInvoiceAmountMinor == data.finalInvoiceTotalMinor
               && data.claimAmountMinor is int && data.claimAmountMinor >= 0
               && data.assessedAmountMinor is int && data.assessedAmountMinor >= 0
               && data.approvedAmountMinor is int && data.approvedAmountMinor >= 0
               && data.insurerResponsibilityMinor is int
               && data.insurerResponsibilityMinor >= 0
               && data.customerResponsibilityMinor is int
               && data.customerResponsibilityMinor >= 0
               && data.insurerReceivedMinor is int
               && data.insurerReceivedMinor >= 0
               && data.customerReceivedMinor is int
               && data.customerReceivedMinor >= 0
               && data.receivedAmountMinor is int && data.receivedAmountMinor >= 0
               && data.writeOffMinor is int && data.writeOffMinor >= 0
               && data.receivedAmountMinor
                  == data.insurerReceivedMinor + data.customerReceivedMinor
               && data.insurerReceivedMinor <= data.insurerResponsibilityMinor
               && data.customerReceivedMinor <= data.customerResponsibilityMinor
               && data.insurerResponsibilityMinor
                    + data.customerResponsibilityMinor + data.writeOffMinor
                  == data.finalInvoiceTotalMinor
               && data.documentCount is int && data.documentCount >= 0
               && data.verifiedDocumentCount is int
               && data.verifiedDocumentCount >= 0
               && data.verifiedDocumentCount <= data.documentCount;
      }

      function validJobAndInvoiceLinks(data) {
        let jobPath = /databases/$(database)/documents/jobCards/$(data.jobCardId);
        let job = get(jobPath).data;
        return id == data.jobCardId
               && exists(jobPath)
               && job.branchId == data.branchId
               && job.customerId == data.customerId
               && job.vehicleId == data.vehicleId
               && job.status == 'delivered'
               // The delivered Job Card already stores the frozen invoice link
               // and total. Reusing that trusted record avoids a second rules
               // read and keeps free-tier evaluation comfortably below limits.
               && job.invoiceId == data.finalInvoiceId
               && job.totalMinor == data.finalInvoiceTotalMinor;
      }

      function validClaimData(data) {
        return validClaimShape(data)
               && validClaimTypes(data)
               && validClaimDates(data)
               && validClaimEnums(data)
               && validClaimMoney(data);
      }

      function validClaimCreate(data) {
        // Check the cheap deterministic Job Card constraints first. Invalid
        // document IDs and non-delivered jobs are rejected before evaluating
        // the complete schema, keeping denied requests below the rules engine's
        // expression limit on the Firebase free tier.
        return validJobAndInvoiceLinks(data) && validClaimData(data);
      }

      function validSettlementUpdate(data) {
        return data.settlementStatus in [
                 'not_due', 'insurer_pending', 'customer_pending', 'part_paid',
                 'overdue', 'disputed', 'reconciled'
               ]
               && data.insurerReceivedMinor is int
               && data.insurerReceivedMinor >= 0
               && data.insurerReceivedMinor <= data.insurerResponsibilityMinor
               && data.customerReceivedMinor is int
               && data.customerReceivedMinor >= 0
               && data.customerReceivedMinor <= data.customerResponsibilityMinor
               && data.receivedAmountMinor
                  == data.insurerReceivedMinor + data.customerReceivedMinor
               && data.status in ['pending', 'approved', 'received', 'rejected']
               && validIsoDate(data.expectedSettlementDate)
               && (!data.keys().hasAny(['insurerPaymentMethod'])
                   || data.insurerPaymentMethod in [
                     'cash', 'cheque', 'bank_transfer', 'card', 'other'
                   ])
               && (!data.keys().hasAny(['insurerPaymentReference'])
                   || data.insurerPaymentReference is string)
               && (!data.keys().hasAny(['customerPaymentReference'])
                   || data.customerPaymentReference is string)
               && (!data.keys().hasAny(['chequeStatus'])
                   || data.chequeStatus in [
                     'not_applicable', 'expected', 'received', 'deposited',
                     'cleared', 'bounced', 'reversed'
                   ])
               && (!data.keys().hasAny(['chequeReceivedAt'])
                   || validIsoDate(data.chequeReceivedAt))
               && (!data.keys().hasAny(['chequeClearedAt'])
                   || validIsoDate(data.chequeClearedAt))
               && (!data.keys().hasAny(['settlementNotes'])
                   || data.settlementNotes is string)
               && (data.settlementStatus != 'reconciled'
                   || (data.insurerReceivedMinor
                         == data.insurerResponsibilityMinor
                       && data.customerReceivedMinor
                         == data.customerResponsibilityMinor));
      }

      function validManagerUpdate(data) {
        // Existing v2 records already passed the full create validator. Updates
        // re-check the editable business values while onlyChanged() protects
        // identity, Job Card links, creator metadata and the schema shape.
        return data.companyName is string && data.companyName.size() > 0
               && data.policyNumber is string && data.claimNumber is string
               && data.currency is string && data.assessorName is string
               && data.assessmentReference is string
               && data.releaseOrderNumber is string && data.notes is string
               && (data.releasedByUid == null || data.releasedByUid is string)
               && validClaimDates(data)
               && validClaimEnums(data)
               && validClaimMoney(data);
      }

      allow read: if isInsuranceManager() || isInsuranceAccountant();
      allow create: if isInsuranceManager()
                    && !exists(/databases/$(database)/documents/insuranceClaims/$(id))
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.updatedByUid == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && validClaimCreate(request.resource.data);
      allow update: if isInsuranceManager()
                    && onlyChanged([
                      'companyName', 'policyNumber', 'claimNumber', 'currency',
                      'accidentDate', 'paymentRoute', 'caseStage',
                      'approvalStatus', 'releaseStatus', 'settlementStatus',
                      'assessorName', 'assessmentDate', 'assessmentReference',
                      'claimAmountMinor', 'assessedAmountMinor',
                      'approvedAmountMinor', 'insurerResponsibilityMinor',
                      'customerResponsibilityMinor', 'insurerReceivedMinor',
                      'customerReceivedMinor', 'receivedAmountMinor',
                      'writeOffMinor', 'releaseOrderNumber', 'releaseOrderDate',
                      'releasedAt', 'releasedByUid', 'expectedSettlementDate',
                      'quantumEstablishedAt', 'dischargeDocumentsReceivedAt',
                      'regulatorySettlementDate', 'status', 'notes',
                      'updatedByUid', 'updatedAt'
                    ])
                    && request.resource.data.updatedByUid == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && validManagerUpdate(request.resource.data);
      allow update: if isInsuranceAccountant()
                    && onlyChanged([
                      'settlementStatus', 'insurerReceivedMinor',
                      'customerReceivedMinor', 'receivedAmountMinor', 'status',
                      'expectedSettlementDate', 'insurerPaymentMethod',
                      'insurerPaymentReference', 'customerPaymentReference',
                      'chequeStatus', 'chequeReceivedAt', 'chequeClearedAt',
                      'settlementNotes', 'updatedByUid', 'updatedAt'
                    ])
                    && request.resource.data.updatedByUid == request.auth.uid
                    && request.resource.data.updatedAt == request.time
                    && validSettlementUpdate(request.resource.data);
      allow delete: if false;
    }

    // ---- Billing ---------------------------------------------------------
    match /invoices/{id} {
      allow read: if isStaff();
      allow create: if isFinance() && validInvoiceState(request.resource.data);
      // Generated invoice amounts are immutable. Payment recording may only
      // update the balance and payment status in its atomic transaction.
      allow update: if isFinance()
                    && validInvoiceState(request.resource.data)
                    && onlyChanged(['amountPaidMinor', 'status', 'updatedByUid', 'updatedAt']);
      allow delete: if isFinance();
    }
    match /payments/{id} {
      allow read: if isStaff();
      allow create: if isFinance() && validPaymentCreate();
      allow delete: if isFinance();
      allow update: if false;
    }

    // ---- Audit log -------------------------------------------------------
    match /auditLog/{id} {
      allow read: if isFinance();
      allow create: if isFinance();
      allow update, delete: if false;
    }

    // ---- Technician Assistant ------------------------------------------
    // Conversations belong to the signed-in staff member and are not shared
    // across accounts. The model never writes these records directly.
    // Open to the full team (owner, manager, front desk/advisor, technician)
    // so owners and front desk can use the assistant too — each user still
    // only ever sees their own chats.
    match /assistantChats/{id} {
      allow read: if isTeam() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeam() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTeam()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }
    match /assistantMessages/{id} {
      allow read: if isTeam() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeam() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
